### Get all states
GET http://localhost:3000/api/locations/states
Content-Type: application/json

### Create sample user 1 (with street)
POST http://localhost:3006/api/auth/register
Content-Type: application/json

{
  "phoneNumber": "+2348011111113",
  "firstName": "Ada",
  "lastName": "Okafor",
  "email": "ada.okafor+rest2@example.com",
  "password": "Password123!",
  "latitude": 6.4384,
  "longitude": 3.4236,
  "city": "Lagos",
  "street": "Adeola Odeku Street",
  "houseNumber": "12",
  "landmark": "Near Eko Hotel",
  "noStreetAddress": false,
  "stateCode": "LA",
  "lgaCode": "03"
}

